# 火山引擎豆包语音「录音文件识别模型 2.0」标准版 — 仅服务端读取，勿加 VITE_ 前缀
# https://docs.volcengine.com/docs/DoubaoVoice/task-submission-http-1

# 必填：控制台 API Key → 请求头 X-Api-Key
VOLC_APP_KEY=

# 资源 ID（豆包录音文件识别 2.0）
VOLC_RESOURCE_ID=volc.seedasr.auc

# submit = 标准版 submit+query（默认）；flash = 极速版（需另开通 turbo）
VOLC_API_MODE=submit

# 旧版控制台可选；新版 X-Api-Key 模式请留空
VOLC_ACCESS_KEY=

# ── DeepSeek（重录 / 假开头检测）— 仅服务端读取，勿加 VITE_ 前缀
# https://platform.deepseek.com/api_keys
# https://api-docs.deepseek.com/

# 必填：DeepSeek API Key → Authorization: Bearer …
DEEPSEEK_API_KEY=

# 可选：模型名（默认 deepseek-flash）
# DEEPSEEK_MODEL=deepseek-flash

# 可选：API 根地址（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
